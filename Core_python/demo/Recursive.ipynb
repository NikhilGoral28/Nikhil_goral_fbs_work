    "#recuresive function\n",
    "\n",
    "def sumOfSeries(n):\n",
    "    if (n==0):\n",
    "        return 0\n",
    "    else:\n",
    "        return n + sumOfSeries(n-1)\n",
    "\n",
    "\n",
    "n = 1002\n",
    "res = sumOfSeries(n)\n",
    "\n",
    "print(res)"
